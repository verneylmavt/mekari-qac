# Copy to .env. Never commit actual keys/passwords.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-5-mini
OPENAI_SQL_MODEL=gpt-5-mini
OPENAI_PLANNER_MODEL=gpt-5-nano
OPENAI_JUDGE_MODEL=gpt-5-nano
DB_HOST=localhost
DB_PORT=5432
DB_NAME=database
DB_USER=fraud_reader
DB_PASSWORD=change-me-reader
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=change-me-admin
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fraud_documents
CORPUS_DIR=data/corpus
EMBED_MODEL_NAME=BAAI/bge-base-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
