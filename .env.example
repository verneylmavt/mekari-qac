MAX_CONCURRENT_CHATS=4
MAX_CONCURRENT_INFERENCE=1
REQUEST_TIMEOUT_SECONDS=120
EXTERNAL_TIMEOUT_SECONDS=30
SQL_TIMEOUT_MS=10000
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
